#!/bin/sh
set -eu
# Only register on the system currently running.
[ "${3:-/}" = / ] || exit 0
for service in local.aiexitguard.ingress local.aiexitguard.rules; do
if /bin/launchctl print "system/$service" >/dev/null 2>&1; then
    /bin/launchctl bootout "system/$service"
fi
# bootout can return before launchd releases the old job on upgrade.
attempt=0
until /bin/launchctl bootstrap system "/Library/LaunchDaemons/$service.plist"; do
    attempt=$((attempt + 1))
    [ "$attempt" -lt 12 ] || exit 1
    /bin/sleep 1
done
done
change=$(/Library/PrivilegedHelperTools/local.aiexitguard.rules --upgrade-hosts)
# The system installer runs as root and /private/var/db is root-owned.
pending=/private/var/db/local.aiexitguard.dns-refresh-pending
case "$change" in
    changed) [ -d "$pending" ] || /bin/mkdir -m 700 "$pending" ;;
    "") ;;
    *) exit 1 ;;
esac
if [ -d "$pending" ]; then
    /usr/bin/dscacheutil -flushcache
    /usr/bin/killall -HUP mDNSResponder
    /bin/rmdir "$pending"
fi

# Relaunch the menu bar app automatically for the logged-in console user.
console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
if [ -n "$console_user" ] && [ "$console_user" != "root" ] && [ "$console_user" != "loginwindow" ]; then
    console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || true)
    if [ -n "$console_uid" ]; then
        /usr/bin/pkill -u "$console_uid" -x AIExitGuard >/dev/null 2>&1 || true
        /bin/sleep 1
        /bin/launchctl asuser "$console_uid" /usr/bin/open -a "/Applications/AI Exit Guard.app" >/dev/null 2>&1 || true
    fi
fi
