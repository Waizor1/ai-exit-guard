#!/bin/zsh
set -eu
name="$0:t"
case "$name" in
  agy|guarded-antigravity)
    client=$("${0:A:h}/guard" t3-path)
    ;;
  guarded-codex|guarded-claude)
    export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
    client=$(whence -p "${name#guarded-}")
    ;;
  *) exit 64;;
esac
[[ -x "$client" ]] || exit 69
# Compatibility for shortcuts installed before domain routing. Only clear
# variables assigned by Guard. T3 and the user own every other setting.
for key in HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy; do
  if [[ "${(P)key:-}" == "http://127.0.0.1:39178" ]]; then unset "$key"; fi
done
exec "$client" "$@"
